{
  "name": "@archsmith/mcp-server",
  "version": "0.5.2",
  "description": "MCP server exposing ArchSmith's render/validate/registry lookups to any MCP-capable agent, over stdio.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "archsmith-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "cd dist && node --test"
  },
  "dependencies": {
    "@archsmith/renderer": "^0.6.0",
    "@archsmith/schema": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "homepage": "https://github.com/ayeshLK/archsmith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayeshLK/archsmith.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/ayeshLK/archsmith/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "diagram",
    "architecture",
    "svg",
    "agent-tools"
  ]
}
