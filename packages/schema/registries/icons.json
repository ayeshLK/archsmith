    "displayStrokeWidth": 2,
    "strokeLineCap": "round",
    "strokeLineJoin": "round",
    "fill": "none",
    "description": "One monochrome outline mark, legible at 16×16. The 3-unit source stroke scales to 2px at the standard 16px display size. Geometry carries no color."
  },
