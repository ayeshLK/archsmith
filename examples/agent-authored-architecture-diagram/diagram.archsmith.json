{
  "$schema": "https://ayeshlk.github.io/archsmith/schema/0.3.6/diagram-schema.json",
  "schemaVersion": "0.3.6",
  "title": "Document Processing Platform — Architecture",
  "subtitle": "Agent-authored example from a fictional plain-English requirement",
  "colorTheme": {
    "family": "standard"
  },
  "columns": {
    "inboundActors": {
      "items": [
        {
          "title": "Employee Web App",
          "descriptionLines": [
            "Internal browser SPA",
            "for document uploads"
          ],
          "dotColor": "green",
          "icon": "actor"
        }
      ]
    },
    "ingress": {
      "gateway": {
        "label": "API Gateway"
      }
    },
    "corePlatform": {
      "deployedOn": "Managed Application Runtime",
      "subLayers": [
        {
          "registryId": "execution-and-capability",
          "rows": [
            [
              {
                "title": "Document Intake Service",
                "descriptionLines": [
                  "Receives and accepts",
                  "document uploads"
                ],
                "icon": "service"
              }
            ],
            [
              {
                "title": "Malware Scan Coordinator",
                "descriptionLines": [
                  "Coordinates external",
                  "malware scanning"
                ],
                "icon": "service"
              }
            ],
            [
              {
                "title": "Metadata Extraction Service",
                "descriptionLines": [
                  "Extracts metadata",
                  "from documents"
                ],
                "icon": "service"
              }
            ]
          ]
        }
      ],
      "systemsOfRecord": {
        "registryId": "systems-of-record",
        "items": [
          {
            "title": "Document Object Store",
            "descriptionLines": [
              "Stores original",
              "documents"
            ],
            "icon": "data-store"
          },
          {
            "title": "Metadata Database",
            "descriptionLines": [
              "Stores extracted",
              "document metadata"
            ],
            "icon": "data-store"
          }
        ]
      }
    },
    "egress": {
      "gateway": {
        "label": "API Gateway"
      }
    },
    "externalSystems": {
      "clusters": [
        {
          "name": "Security Services",
          "items": [
            {
              "title": "Malware Scanning Service",
              "descriptionLines": [
                "External malware",
                "scanning capability"
              ],
              "icon": "external"
            }
          ]
        },
        {
          "name": "Communication Services",
          "items": [
            {
              "title": "Notification Delivery Service",
              "descriptionLines": [
                "Delivers status",
                "notifications to users"
              ],
              "icon": "external"
            }
          ]
        }
      ]
    }
  },
  "legend": {
    "entries": [
      {
        "colorToken": "green",
        "label": "Execution and Capability Layer"
      },
      {
        "colorToken": "amber",
        "label": "Systems of Record"
      }
    ]
  }
}
