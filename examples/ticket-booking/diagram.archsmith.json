{
  "$schema": "https://ayeshlk.github.io/archsmith/schema/0.3.4/diagram-schema.json",
  "schemaVersion": "0.3.4",
  "title": "Event Ticket Booking Platform — Architecture",
  "subtitle": "Reference example exercising every schema feature (fictional platform, no real system)",
  "colorTheme": { "family": "standard" },
  "columns": {
    "inboundActors": {
      "items": [
        {
          "dotColor": "purple",
          "title": "Ticketing Web App",
          "descriptionLines": [
            "React SPA — customer-facing browsing and booking flow",
            "OIDC login (IdP) · Bearer ID token"
          ]
        },
        {
          "dotColor": "teal",
          "title": "Box Office Partner Integration",
          "descriptionLines": [
            "Third-party resellers and venue box offices — B2B channel",
            "M2M client-credentials · booking + inventory scopes"
          ]
        }
      ]
    },
    "ingress": {
      "gateway": { "label": "API Gateway", "sublabel": "Ticketing Runtime" }
    },
    "corePlatform": {
      "deployedOn": "WSO2 Developer Platform",
      "subLayers": [
        {
          "registryId": "discovery-and-governance",
          "rows": [
            [
              {
                "eyebrow": "API management",
                "title": "Booking API Control Plane",
                "descriptionLines": ["Request routing, lifecycle management, rate limiting for all public APIs."]
              },
              {
                "eyebrow": "Identity & policy",
                "title": "Ticketing Identity Platform",
                "descriptionLines": ["OIDC · M2M client-credentials · role-based access control."]
              }
            ]
          ]
        },
        {
          "registryId": "execution-and-capability",
          "rows": [
            [
              {
                "title": "Booking Service",
                "descriptionLines": ["Core reservation lifecycle, seat holds, dynamic pricing."]
              },
              {
                "title": "Notification Dispatcher",
                "descriptionLines": ["Async batch job — confirmation emails, event reminder pushes."]
              }
            ]
          ]
        },
        {
          "registryId": "entity-layer",
          "rows": [
            [
              {
                "title": "Event & Seat Entity Service",
                "descriptionLines": ["Canonical event, venue, and seat inventory model, deduplicated across booking, box office, and support systems."]
              }
            ]
          ]
        }
      ],
      "systemsOfRecord": {
        "registryId": "systems-of-record",
        "items": [
          {
            "title": "Booking DB",
            "descriptionLines": ["PostgreSQL — shared \"bookings\" schema"],
            "pill": { "label": "PRIMARY", "semantic": "primary" }
          },
          {
            "title": "Legacy Settlement Export",
            "descriptionLines": ["Nightly CSV batch for finance reconciliation"]
          },
          {
            "title": "Document Archive",
            "descriptionLines": ["Signed venue contracts and invoices"]
          }
        ]
      }
    },
    "egress": {
      "gateway": { "label": "API Gateway", "sublabel": "Outbound M2M" }
    },
    "externalSystems": {
      "clusters": [
        {
          "name": "Shared Internal Services",
          "items": [
            {
              "dotColor": "purple",
              "title": "Billing Service",
              "descriptionLines": ["OAuth2 M2M — invoice generation, refunds"],
              "pill": { "label": "via egress", "semantic": "viaEgress" }
            },
            {
              "dotColor": "teal",
              "title": "Analytics Pipeline",
              "descriptionLines": ["Event stream — booking + engagement telemetry"],
              "pill": { "label": "via egress", "semantic": "viaEgress" }
            },
            {
              "dotColor": "navy",
              "title": "Customer Relationship Management and Support Case Management Platform",
              "descriptionLines": ["OAuth2 M2M — support case sync"],
              "pill": { "label": "via egress", "semantic": "viaEgress" },
              "acronym": "CRM/Support"
            }
          ]
        },
        {
          "name": "Payments Network",
          "items": [
            {
              "dotColor": "amber",
              "title": "Card Processor",
              "descriptionLines": ["PCI-scoped M2M — authorization + capture"],
              "pill": { "label": "via egress", "semantic": "viaEgress" }
            },
            {
              "dotColor": "amber",
              "title": "Fraud Detection Service",
              "descriptionLines": ["Real-time risk scoring on checkout"],
              "pill": { "label": "via egress", "semantic": "viaEgress" }
            }
          ]
        }
      ]
    }
  },
  "legend": {
    "entries": [
      { "colorToken": "purple", "label": "Discovery and Governance" },
      { "colorToken": "green", "label": "Execution and Capability Layer" },
      { "colorToken": "teal", "label": "Entity Layer" },
      { "colorToken": "amber", "label": "Systems of Record and Knowledge" },
      { "colorToken": "mint", "label": "Ingress / Egress gateways" }
    ],
    "abbreviations": [
      { "acronym": "CRM/Support", "fullName": "Customer Relationship Management and Support Case Management Platform" }
    ]
  },
  "notes": [
    "Note — this is a fictional reference example (an event ticket booking platform),",
    "not a real system architecture. It exists to exercise every schema feature (real",
    "Entity Layer, multi-cluster External Systems, a supplied acronym) in one document."
  ]
}
