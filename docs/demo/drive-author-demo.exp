#!/usr/bin/expect -f
# Drives a real `archsmith author` session for the README demo GIF --
# builds the exact examples/ticket-booking/diagram.archsmith.json
# reference example live through the wizard (minus two fields with no
# live authoring path yet -- see the two substitutions noted inline
# below). Run only via: bash docs/demo/record-author-demo.sh (which
# wraps this in asciinema rec). See docs/demo/README.md for the full
# regenerate steps.

set timeout 6
log_user 1

set script_dir [file dirname [file normalize [info script]]]
set repo_root [file dirname [file dirname $script_dir]]

# log_user 0 around spawn suppresses expect's own "spawn <full command>"
# announcement, which would otherwise print the absolute local filesystem
# path (including the machine's username) straight into the recording.
log_user 0
spawn node "$repo_root/packages/cli/dist/index.js" author
log_user 1

proc drain {} {
  global spawn_id
  while 1 {
    set matched 0
    expect {
      -timeout 0 -re ".+" { set matched 1 }
      timeout { set matched 0 }
    }
    if {!$matched} break
  }
}

proc type_text {text} {
  global spawn_id
  # Discard anything already sitting in the buffer before typing -- a
  # screen's own hint copy can coincidentally contain the exact value
  # we're about to type (e.g. the Pill field's hint literally says
  # `e.g. "PRIMARY"`), and without this, the echo-confirmation below
  # would match that stale leftover text instead of genuinely waiting
  # for our own input to land -- caught empirically as a reliable,
  # 100%-reproducible corruption on that one specific field.
  drain
  foreach char [split $text ""] {
    send -- $char
    after 35
  }
  # Confirm the tail of what we just typed actually landed and got
  # echoed back before ever sending Enter. A fixed delay alone can't
  # guarantee this: if Enter's `send` happens to land in the same read()
  # chunk as trailing text (a real risk under any scheduling hiccup),
  # ink-text-input treats the merged chunk as a paste and inserts the
  # raw \r literally into the field instead of submitting -- caught
  # empirically as a literal "\r" showing up inside a saved field value.
  # Waiting for an echo of the real typed text (not just a fixed delay)
  # is what actually proves the app's read loop is idle and caught up.
  if {[string length $text] > 0} {
    set tail_len [expr {min([string length $text], 16)}]
    set tail [string range $text end-[expr {$tail_len - 1}] end]
    expect -timeout 3 -ex $tail
  }
  after 400
}

proc read_highlight {} {
  global expect_out
  regsub -all {\x1b\[[0-9;?]*[A-Za-z]} $expect_out(buffer) "" clean
  set hl ""
  foreach line [split $clean "\n"] {
    set line [string trim $line "\r"]
    if {[regexp {^❯\s*(\S+)} $line -> word]} { set hl $word; break }
  }
  return $hl
}

# Selects a named color from the Color Accent list (order: purple, green,
# teal, amber, navy, mint) by pressing Down one step at a time and
# confirming the actual highlighted option (marked with "❯", not
# ASCII ">") after each press, using "mint" (the list's last entry) as a
# sentinel that the full repaint has landed before reading it back.
# Caught empirically: a run sending all N presses back-to-back with no
# per-press verification landed one position short (navy selected amber
# instead) with no other visible error -- a single dropped arrow-key send,
# the same class of race already handled for Enter in confirm_submit, but
# with no downstream signal at all if left unverified. Nudges with one
# more press and rechecks if a given press didn't register.
proc select_color {name {max_extra 4}} {
  global spawn_id expect_out
  set order {purple green teal amber navy mint}
  set target [expr {[lsearch -exact $order $name] + 1}]
  set pos 0
  set hl ""
  while {$pos < $target} {
    drain
    send -- "\x1b\[B"
    expect -timeout 2 -re {mint}
    set hl [read_highlight]
    incr pos
  }
  for {set r 0} {$r < $max_extra} {incr r} {
    if {$hl eq $name} { return }
    set cur [lsearch -exact $order $hl]
    set want [lsearch -exact $order $name]
    if {$cur < 0 || $want <= $cur} break
    drain
    send -- "\x1b\[B"
    expect -timeout 2 -re {mint}
    set hl [read_highlight]
  }
  if {$hl ne $name} {
    send_user "\n\[FAILED to confirm color selection: $name -- last seen: $hl\]\n"
    exit 1
  }
}

# A deliberate pause purely for a human viewer's benefit -- long enough to
# read the screen that was just reached before the next keystroke fires.
# Separate from the per-send `after`s above, which exist for correctness.
proc beat {{ms 500}} {
  after $ms
}

# Sends Enter and waits for `next_pattern` (a string unique to the screen
# that submission should reach -- never a bare recurring word like "Title",
# which reappears on every repaint of the *current* screen too and would
# match stale backlog instead of genuine progress). Drains first for the
# same stale-hint-collision reason `type_text` does. If nothing arrives
# within the per-attempt timeout, resends Enter and tries again -- caught
# empirically: Ink's first Enter after a burst of typed keystrokes is
# sometimes silently swallowed (not inserted, not submitted), most likely
# an occasional slow-render race rather than a fixed timing threshold. A
# 2s per-attempt window is far beyond any real render, so a resend here
# only ever fires when the previous Enter truly had no effect -- re-
# submitting the same (unchanged) typed value or the same (unchanged)
# highlighted select option is always safe.
proc confirm_submit {next_pattern {retries 6}} {
  global spawn_id
  for {set i 0} {$i < $retries} {incr i} {
    drain
    send -- "\r"
    set matched 0
    expect {
      -timeout 2 -re $next_pattern { set matched 1 }
      timeout { set matched 0 }
    }
    if {$matched} {
      return
    }
  }
  send_user "\n\[FAILED to confirm submission -- never reached: $next_pattern\]\n"
  exit 1
}

